rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // UserPhotos folder - only authenticated users can read/write their own photos
    match /UserPhotos/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024  // 5MB max
                   && request.resource.contentType.matches('image/(webp|jpeg|jpg|png)');
    }
    
    // All other files - authenticated users only
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null 
               && request.resource.size < 5 * 1024 * 1024;
    }
  }
}